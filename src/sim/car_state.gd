class_name CarState
extends RefCounted

var id := ""
var driver_name := ""
var is_player := false
var player_index := 0
var body := "dart"
var paint := "cyan"
var personality := "balanced"
var skill := 1.0
var weapon_bias := 0.6
var pos := Vector2.ZERO
var prev_pos := Vector2.ZERO
var vel := Vector2.ZERO
var heading := 0.0
var hp := 100.0
var max_hp := 100.0
var accel := 540.0
var brake := 820.0
var max_speed := 470.0
var grip := 8.2
var turn_rate := 3.05
var damage_taken := 1.0
var missile_damage := 22.0
var rear_damage := 18.0
var mine_damage := 34.0
var has_rear := false
var has_mines := false
var ammo_missile := 16
var ammo_rear := 0
var ammo_mine := 0
var cap_missile := 36
var cap_rear := 24
var cap_mine := 16
var cd_missile := 0.0
var cd_rear := 0.0
var cd_mine := 0.0
var next_cp := 1
var cps_passed := 0
var laps := 0
var finished := false
var finish_time := 0.0
var dnf := false
var knocked_at := 0.0
var wp_index := 0
var wp_travel := 0
var hit_cd := 0.0
var stuck_time := 0.0
var recover_time := 0.0
var recover_steer := 1.0
var lap_start := 0.0
var best_lap := 0.0
var rank := 1
var boost := 1.0
var boosting := false
var drafting := false
var drifting := false
# 0 = tyres hooked up, 1 = the friction circle is used up and the car is sliding.
var slip := 0.0
# Signed weight transfer: positive on power, negative under braking.
var load := 0.0


func apply_spec(spec: Dictionary) -> void:
	id = str(spec.get("id", id))
	driver_name = str(spec.get("name", driver_name))
	is_player = bool(spec.get("is_player", false))
	player_index = int(spec.get("player_index", 0))
	body = str(spec.get("body", body))
	paint = str(spec.get("paint", paint))
	personality = str(spec.get("personality", personality))
	skill = float(spec.get("skill", skill))
	weapon_bias = float(spec.get("weapon_bias", weapon_bias))
	hp = float(spec.get("hp", hp))
	max_hp = float(spec.get("max_hp", max_hp))
	accel = float(spec.get("accel", accel))
	brake = float(spec.get("brake", brake))
	max_speed = float(spec.get("max_speed", max_speed))
	grip = float(spec.get("grip", grip))
	turn_rate = float(spec.get("turn_rate", turn_rate))
	damage_taken = float(spec.get("damage_taken", damage_taken))
	missile_damage = float(spec.get("missile_damage", missile_damage))
	rear_damage = float(spec.get("rear_damage", rear_damage))
	mine_damage = float(spec.get("mine_damage", mine_damage))
	has_rear = bool(spec.get("has_rear", has_rear))
	has_mines = bool(spec.get("has_mines", has_mines))
	ammo_missile = int(spec.get("ammo_missile", ammo_missile))
	ammo_rear = int(spec.get("ammo_rear", ammo_rear))
	ammo_mine = int(spec.get("ammo_mine", ammo_mine))
	cap_missile = int(spec.get("cap_missile", cap_missile))
	cap_rear = int(spec.get("cap_rear", cap_rear))
	cap_mine = int(spec.get("cap_mine", cap_mine))
